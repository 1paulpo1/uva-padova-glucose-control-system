# Large result artifacts — generated, not for git (see ~/Documents/uva-padova-archive-local-backup)
# Synthetic study (virtual patients) — hours to recompute, archived locally
synthetic_study/**/crossval_results*.json
synthetic_study/**/crossval_results*.csv
synthetic_study/**/100-*.json
synthetic_study/output/
synthetic_study/composite/
synthetic_study/*.png
# Local online-evaluation runs (unreferenced leftovers, regenerable)
online_exp*.json
online_glucose*.json
online_test*.json
preset_*.json
# Curated example outputs (regenerated via examples/*/run.sh, never committed)
# Note: example scripts (run.sh) and docs (*.md) ARE tracked; only outputs are ignored.
examples/*/output/
examples/**/*.png

# Real-world validation outputs (real patient data — privacy + size)
real_world_validation/datasets/
real_world_validation/output/
real_world_validation/figures/
real_world_validation/validation_results*.json
real_world_validation/validation_results*.csv

# Legacy paths (kept for backward compatibility — now renamed)
crossval/output/
validation/figures/

# Profiling / analysis outputs (ignore generated CSV/PNG by default)
# No exceptions for run artifacts: figures are regenerated via scripts, never committed.
*.csv
*.png
!config/**/*.csv
!real_world_validation/identifiability/**/*.csv
# Keep small example CSVs explicitly if needed via git add -f (do not blanket un-ignore synthetic_study CSVs — they are large results)

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Secrets / local config
.env
.env.local

# Archive backup (local only, not for git)
uva-padova-archive-local-backup/
