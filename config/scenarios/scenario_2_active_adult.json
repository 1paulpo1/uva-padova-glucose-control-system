{
  "_description": "Scenario 2: 'Active Adult with Variable Schedule'. Athlete or shift worker. Large CHO spread, fluctuating meal times, moderate bolus omissions, higher basal variability from physical activity.",

  "simulation": {
    "duration_min": 1440,
    "cgm_interval": 5,
    "perturbation_std": 0.35
  },

  "body_weight_kg": 70.0,

  "meal_generation": {
    "daily_cho_g": 250,
    "n_meals_per_day": 4,
    "split_cv": 0.4,
    "time_cv": 0.2
  },

  "cgm_noise": {
    "fixed_sd": 3.0,
    "relative_sd": 4.0,
    "max_dropout_min": 10,
    "dropout_prob": 0.005
  },

  "meal_errors": {
    "skip_prob": 0.04,
    "timing_shift_sd": 8.0,
    "amount_noise_sd": 0.2
  },

  "insulin_errors": {
    "bolus_skip_prob": 0.03,
    "bolus_dose_cv": 0.15,
    "bolus_timing_shift_sd": 6.0,
    "basal_rate_cv": 0.18
  },

  "optimizer": {
    "n_cmaes_restarts": 12,
    "cmaes_evals": 1200
  }
}
